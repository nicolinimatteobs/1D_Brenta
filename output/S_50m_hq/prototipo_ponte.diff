+# Legge il file delle strutture interne (ponti e manufatti con scala di deflusso): intestazione, poi una
+# riga per struttura con nome, numero della sezione a monte della struttura (come nella prima colonna
+# della geometria) e file della scala di deflusso (senza intestazione: quota [m s.l.m.], portata [m3/s]).
+# Alla scala viene aggiunto il punto a portata nulla, alla quota del talweg della sezione di monte.
+# Restituisce un vettore di (nome, m, Q, η); con filename vuoto il vettore è vuoto
+function LOAD_STRUCTURES(filename, imax, b_min)
+    ponti = @NamedTuple{nome::String, m::Int, Q::Vector{Float64}, η::Vector{Float64}}[]
+    isempty(filename) && return ponti
+    isfile(filename) || error("File delle strutture '$filename' non trovato (riga 28 di settings.txt)")
+    for (n, line) in enumerate(eachline(filename))
+        (n == 1 || isempty(strip(line))) && continue
+        campi = strip.(split(line, ','))
+        length(campi) == 3 || error("La riga $n di '$filename' non ha 3 colonne (nome, sezione di monte, scala di deflusso)")
+        nome = String(campi[1]); m = parse(Int, campi[2]); scala = String(campi[3])
+        2 <= m <= imax - 2 || error("Struttura $nome: la sezione di monte $m deve essere tra 2 e $(imax - 2)")
+        isfile(scala) || error("Struttura $nome: scala di deflusso '$scala' non trovata")
+        Q = [0.0]; η = [b_min[m]]
+        for l in eachline(scala)
+            isempty(strip(l)) && continue
+            val = parse.(Float64, split(strip(l), ','))
+            push!(η, val[1]); push!(Q, val[2])
+        end
+        all(diff(Q) .> 0.0) || error("Struttura $nome: le portate della scala '$scala' devono essere crescenti")
+        all(diff(η) .>= 0.0) || error("Struttura $nome: le quote della scala '$scala' non devono diminuire con la portata")
+        push!(ponti, (; nome, m, Q, η))
+        println("Struttura interna $nome: sezione di monte $m, sezione di valle $(m + 1), scala '$scala' ($(length(Q) - 1) punti)")
+    end
+    return ponti
+end
+
+# Quota del pelo libero della scala di deflusso (Qk, ηk) alla portata Q e pendenza dη/dQ del tratto,
+# con interpolazione lineare. Oltre l'ultimo punto estrapola con l'ultimo tratto; con portata negativa
+# restituisce la quota del primo punto (il talweg) e pendenza nulla
+@inline function HQ_LEVEL(Qk, ηk, Q)
+    Q <= 0.0 && return ηk[1], 0.0
+    j = clamp(searchsortedlast(Qk, Q), 1, length(Qk) - 1)
+    s = (ηk[j+1] - ηk[j])/(Qk[j+1] - Qk[j])
+    return ηk[j] + s*(Q - Qk[j]), s
+end
